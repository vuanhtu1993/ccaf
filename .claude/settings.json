{
  "permissions": {
    "allow": [
      "Bash(npm --prefix mcp-server run build)",
      "Bash(npm --prefix mcp-server run probe)",
      "Bash(npm --prefix agent-sdk run build)",
      "Bash(npm --prefix agent-sdk run typecheck)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Read(./docs/**)",
      "Read(./.claude/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "timeout": 15,
            "statusMessage": "Đang nạp bối cảnh buổi học..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-dangerous.sh",
            "timeout": 10,
            "statusMessage": "Kiểm tra lệnh shell..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-frontmatter.sh",
            "timeout": 15,
            "statusMessage": "Validate frontmatter .claude/..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-frontmatter.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/study-log.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
