{
  "name": "cca-coach-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Custom MCP server: knowledge base + quiz bank for the CCA-F study repo",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cca-coach": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "node scripts/probe.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
